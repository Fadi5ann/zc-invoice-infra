# --- DATABASE CONFIGURATION ---
DB_ROOT_PASSWORD=change_me_to_secure_password
DB_NAME=zc_invoice_db
DB_USER=zc_invoice_user
DB_PASSWORD=change_me_to_secure_password

# --- SMTP CONFIGURATION ---
SMTP_USER=your-email@domain.com
SMTP_PASS=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- APPLICATION CONFIGURATION ---
APP_NAME=ZC Invoice System
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
NODE_ENV=development

# --- SECURITY - JWT ---
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-required

# --- MONITORING - GRAFANA ---
GRAFANA_USERNAME=admin
# Change this password! Generate with: openssl rand -base64 16
GRAFANA_PASSWORD=change_to_secure_password_in_production

# --- AUTHENTICATION - NEXTAUTH ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-nextauth-key-minimum-32-characters

# --- FEATURES & FLAGS ---
FEATURES_ENABLE_REALTIME=true
FEATURES_ENABLE_NOTIFICATIONS=true

# Security & Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url/here

# API Endpoints
AUTH_API_URL=http://localhost/api/auth/login
METRICS_API_URL=http://localhost/api/metrics